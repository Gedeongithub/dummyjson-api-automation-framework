        {
          "name": "Get_user_profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "const schema = {\r",
                  "    \"type\": \"object\",\r",
                  "    \"required\": [\"id\", \"firstName\", \"lastName\", \"email\", \"age\"],\r",
                  "    \"properties\": {\r",
                  "        \"id\": { \"type\": \"integer\" },\r",
                  "        \"firstName\": { \"type\": \"string\" },\r",
                  "        \"lastName\": { \"type\": \"string\" },\r",
                  "        \"email\": { \"type\": \"string\" },\r",
                  "        \"age\": { \"type\": \"number\" }\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "\r",
                  "pm.test(\"Schema Validation: Data types are strictly enforced\", () => {\r",
                  "    pm.response.to.have.jsonSchema(schema);\r",
                  "});\r",
                  "\r",
                  "let res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time < 200ms\", () => {\r",
                  "    pm.expect(pm.response.responseTime).to.be.above(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User ID is correct\", () => {\r",
                  "    pm.expect(res.id).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Email exists\", () => {\r",
                  "    pm.expect(res.email).to.be.a(\"string\");\r",
                  "});"
                ],
