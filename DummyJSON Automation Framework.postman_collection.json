  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();\r",
                  "pm.environment.set(\"currentTimeStamp\",timestamp);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "let res = pm.response.json();\r",
                  "let requestBody = JSON.parse(pm.request.body.raw);\r",
                  "\r",
                  "pm.test(\"Login success\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token exists\", () => {\r",
                  "    pm.expect(res).to.have.property(\"accessToken\");\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"accessToken\", res.accessToken);\r",
                  "\r",
                  "pm.environment.set(\"username\", requestBody.username);\r",
                  "pm.environment.set(\"password\", requestBody.password);\r",
                  "\r",
                  "let token = pm.environment.get(\"accessToken\");\r",
                  "\r",
                  "pm.test(\"Token is a non-empty string\", () => {\r",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"emilys\",\r\n  \"password\": \"emilyspass\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
